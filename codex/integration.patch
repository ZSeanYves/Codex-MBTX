+/// Prefix a fully prepared command with the trusted transparent MBTX launcher.
+///
+/// This is intentionally applied after approvals, shell policy, and sandbox
+/// transforms have inspected the original command. Keeping the launcher out of
+/// `UnifiedExecRequest::command` preserves the command shown to the user and
+/// used by approval, policy, network, and telemetry paths.
+pub(crate) fn apply_mbtx_launcher(
+    launcher: Option<&[String]>,
+    command: Vec<String>,
+) -> Result<Vec<String>, ToolError> {
+    let Some(launcher) = launcher else {
+        return Ok(command);
+    };
+    if launcher.is_empty()
+        || !std::path::Path::new(&launcher[0]).is_absolute()
+        || launcher.iter().any(|arg| arg.contains('\0'))
+    {
+        return Err(ToolError::Rejected(
+            "mbtx_command must start with an absolute executable path and contain no NUL"
+                .to_string(),
+        ));
+    }
+    let mut launched = launcher.to_vec();
+    launched.extend(["exec".to_string(), "--".to_string()]);
+    launched.extend(command);
+    Ok(launched)
+}
