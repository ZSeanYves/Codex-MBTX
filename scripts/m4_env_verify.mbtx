import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/json",
}

async fn main {
  let dir = @fs.tmpdir(prefix="m4-environment-")
  @fs.chmod(dir, 0o755)
  @fs.mkdir("\{dir}/home")
  @fs.mkdir("\{dir}/work")
  @fs.mkdir("\{dir}/private", permission=0o700)
  @fs.write_file("\{dir}/private/marker", "private", permission=0o600)
  @shell.Cmd("sudo", ["-n", "chown", "-R", "mbtx-eval:mbtx-eval", "\{dir}/home", "\{dir}/work"]).run()
  let request : Json = {
    "id": "environment-check", "op": "run", "cwd": "\{dir}/work".to_json(), "timeout_ms": 30000,
    "source": "import { \"moonbitlang/async\", \"moonbitlang/async/fs\" }\nasync fn main { @fs.write_file(\"marker\", \"ok\") }",
  }
  let output = @shell.Cmd("sudo", ["-n", "-u", "mbtx-eval", "--", "/usr/bin/env", "-i",
    "PATH=/opt/mbtx-eval-tools/moon/bin:/usr/local/bin:/usr/bin:/bin", "HOME=\{dir}/home", "MOON_HOME=/opt/mbtx-eval-tools/moon",
    "/opt/mbtx-eval-tools/bin/mbtx", "--request", request.stringify()],
    inherit_env=false, env={ "PATH": "/usr/bin:/bin" }).output(timeout_ms=45_000)
  let mut completed = false
  for line in output.stdout().split("\n") {
    if line.trim().is_empty() { continue }
    if @json.parse(line) is { "event": "completed", "exit_code": 0, .. } { completed = true }
  }
  guard completed else { fail("isolated MBTX preflight failed: " + output.stdout() + output.stderr()) }
  guard @fs.read_file("\{dir}/work/marker").text() == "ok" else { fail("isolated runner did not write output") }
  let access = @shell.Cmd("sudo", ["-n", "-u", "mbtx-eval", "--", "test", "-r", "\{dir}/private/marker"]).status()
  guard access == 1 else { fail("agent can read evaluator-private files") }
  @shell.Cmd("sudo", ["-n", "rm", "-rf", "--", dir]).run()
  println("Isolated MBTX execution and private-file boundary passed; no API key used")
}
