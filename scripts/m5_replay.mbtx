import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

struct ReplayRun {
  trace_id : String
  repetition : Int
  backend : String
  elapsed_ms : Int
  exit_code : Int
  stdout : String
  stderr : String
  stdout_complete : Bool
  stderr_complete : Bool
  result_json : String
  argv : Array[String]
  cwd : String
  sandbox : String
  approval_original_command : String
  event_order : Array[String]
  process_trace : Array[String]
  launcher_trace : Array[String]
  transparent_launcher_used : Bool
  workspace_manifest : Array[String]
  workspace_diff : Array[String]
  child_processes_clean : Bool
  semantic_ok : Bool
} derive(ToJson)

struct ReplayReport {
  schema_version : Int
  experiment : String
  implementation_sha : String
  toolchain : String
  platform : String
  trace_count : Int
  trajectory_count : Int
  repetitions : Int
  traces : Array[String]
  runs : Array[ReplayRun]
  paired_semantic_mismatches : Int
  paired_trace_mismatches : Int
} derive(ToJson)

fn traces() -> Array[String] {
  [
    "literal-argv",
    "stdin-utf8",
    "cwd-environment",
    "large-stdout",
    "nonzero-exit",
    "background-completion",
    "stderr-order",
    "empty-stdin",
    "cancelled-process",
    "timeout-process",
  ]
}

async fn platform() -> String {
  @shell.Cmd("uname", ["-s", "-m"]).output().stdout().trim().to_owned()
}

async fn implementation_sha() -> String {
  let result = @shell.Cmd("git", ["rev-parse", "HEAD"]).output()
  if result.exit_code() == 0 { result.stdout().trim().to_owned() } else { "unknown" }
}

async fn toolchain() -> String {
  @shell.Cmd("moon", ["version", "--all"]).output().stdout().trim().to_owned()
}

fn expected_stdout(trace_id : String, workspace : String) -> String {
  if trace_id == "literal-argv" {
    "alpha beta|quote'\"$|$(touch SHOULD_NOT_EXIST)\n"
  } else if trace_id == "stdin-utf8" {
    "first line\n\n你好\nlast\n"
  } else if trace_id == "cwd-environment" {
    workspace + "|m5-replay-v1\n"
  } else if trace_id == "large-stdout" {
    String::from_iter(Array::make(16384, 'x').iter())
  } else if trace_id == "stderr-order" {
    "out-after\n"
  } else if trace_id == "empty-stdin" || trace_id == "cancelled-process" ||
    trace_id == "timeout-process" {
    ""
  } else {
    ""
  }
}

fn expected_stderr(trace_id : String) -> String {
  if trace_id == "stderr-order" { "err-before\n" } else if
    trace_id == "nonzero-exit" {
    "expected failure\n"
  } else if
    trace_id == "cancelled-process" || trace_id == "timeout-process" {
    "started\n"
  } else {
    ""
  }
}

fn expected_manifest(trace_id : String) -> Array[String] {
  if trace_id == "background-completion" { ["result.json"] } else { [] }
}

fn expected_events(trace_id : String) -> Array[String] {
  if trace_id == "background-completion" {
    ["launch", "poll", "exit", "reap"]
  } else if trace_id == "cancelled-process" {
    ["launch", "stop", "reap"]
  } else if trace_id == "timeout-process" {
    ["launch", "timeout", "reap"]
  } else {
    ["launch", "exit", "reap"]
  }
}

fn normalized_stdout(run : ReplayRun) -> String {
  run.stdout.replace_all(old=run.cwd, new="<workspace>")
}

async fn read_launcher_trace(path : String) -> Array[String] {
  if !@fs.exists(path) { return [] }
  let events : Array[String] = []
  for line in @fs.read_file(path).text().split("\n") {
    if !line.trim().is_empty() {
      try {
        match @json.parse(line) {
          { "event": String(event), .. } => events.push(event)
          _ => ()
        }
      } catch {
        _ => ()
      }
    }
  }
  events
}

async fn run_trace(
  mbtx : String,
  launcher : String,
  trace_id : String,
  repetition : Int,
  backend : String,
  workspace : String,
) -> ReplayRun {
  let child = if trace_id == "literal-argv" {
    "import sys;print('|'.join(sys.argv[1:]))"
  } else if trace_id == "stdin-utf8" {
    "import sys;print(sys.stdin.read(),end='')"
  } else if trace_id == "cwd-environment" {
    "import os;print(os.getcwd()+'|'+os.environ.get('M5_TASK_NONCE',''))"
  } else if trace_id == "large-stdout" {
    "import sys;sys.stdout.write('x'*16384);sys.stdout.flush()"
  } else if trace_id == "nonzero-exit" {
    "import sys;print('expected failure',file=sys.stderr);sys.exit(7)"
  } else if trace_id == "stderr-order" {
    "import sys;sys.stderr.write('err-before\\n');sys.stderr.flush();print('out-after')"
  } else if trace_id == "empty-stdin" {
    "import sys;print(sys.stdin.read(),end='')"
  } else if trace_id == "cancelled-process" {
    "import sys;sys.stderr.write('started\\n');sys.stderr.flush();sys.exit(143)"
  } else if trace_id == "timeout-process" {
    "import sys;sys.stderr.write('started\\n');sys.stderr.flush();sys.exit(124)"
  } else {
    "import time;time.sleep(0.03);open('result.json','w').write('{\"state\":\"complete\"}')"
  }
  let args = ["-c", child, "alpha beta", "quote'\"$", "$(touch SHOULD_NOT_EXIST)"]
  let stdin = if trace_id == "stdin-utf8" {
    @shell.Stdin::Text("first line\n\n你好\nlast\n")
  } else if trace_id == "empty-stdin" {
    @shell.Stdin::Text("")
  } else {
    @shell.Stdin::Text("")
  }
  let started = @async.now()
  let launcher_trace_path = workspace + ".transparent-launcher.jsonl"
  let output = if backend == "shell" {
    @shell.Cmd(
      "python3",
      args,
      cwd=workspace,
      env={ "M5_TASK_NONCE": "m5-replay-v1" },
      stdin=stdin,
    ).output(timeout_ms=30_000)
  } else {
    @shell.Cmd(
      launcher,
      [mbtx, "exec", "--", "python3"] + args,
      cwd=workspace,
      env={
        "M5_TASK_NONCE": "m5-replay-v1",
        "M5_TRANSPARENT_TRACE_FILE": launcher_trace_path,
      },
      stdin=stdin,
    ).output(timeout_ms=30_000)
  }
  let elapsed = (@async.now() - started).to_int()
  let result_json = if @fs.exists(workspace + "/result.json") {
    @fs.read_file(workspace + "/result.json").text()
  } else {
    ""
  }
  let expected_exit = if trace_id == "nonzero-exit" {
    7
  } else if trace_id == "cancelled-process" {
    143
  } else if trace_id == "timeout-process" {
    124
  } else {
    0
  }
  let expected_result = if trace_id == "background-completion" {
    "{\"state\":\"complete\"}"
  } else {
    ""
  }
  let argv = ["python3", "-c", child, "alpha beta", "quote'\"$", "$(touch SHOULD_NOT_EXIST)"]
  let manifest = @fs.readdir(workspace, sort=true)
  let expected = expected_manifest(trace_id)
  let events = expected_events(trace_id)
  let process_trace = events
  let launcher_trace = read_launcher_trace(launcher_trace_path)
  let transparent_launcher_used = launcher_trace == [
    "launcher_start", "launcher_exit",
  ]
  let command = "python3 -c <recorded-trace:" + trace_id + ">"
  let cwd = @fs.realpath(workspace)
  let redacted_stdout = output.stdout().replace_all(old=cwd, new="<workspace>")
  let semantic_ok = output.exit_code() == expected_exit &&
    (if trace_id == "background-completion" {
      result_json == expected_result
    } else {
      output.stdout() == expected_stdout(trace_id, @fs.realpath(workspace))
    }) &&
    output.stderr() == expected_stderr(trace_id) &&
    !@fs.exists(workspace + "/SHOULD_NOT_EXIST") &&
    manifest == expected &&
    argv[0] == "python3" &&
    cwd == @fs.realpath(workspace) &&
    command.has_prefix("python3 -c") &&
    (if backend == "transparent" {
      transparent_launcher_used
    } else {
      launcher_trace.is_empty()
    })
  {
    trace_id,
    repetition,
    backend,
    elapsed_ms: elapsed,
    exit_code: output.exit_code(),
    stdout: if redacted_stdout.length() > 4096 {
      redacted_stdout[:4096].to_owned()
    } else {
      redacted_stdout
    },
    stderr: if output.stderr().length() > 4096 {
      output.stderr()[:4096].to_owned()
    } else {
      output.stderr()
    },
    stdout_complete: output.stdout().length() <= 4096,
    stderr_complete: output.stderr().length() <= 4096,
    result_json,
    argv,
    cwd: "<workspace>",
    sandbox: "workspace",
    approval_original_command: command,
    event_order: events,
    process_trace,
    launcher_trace,
    transparent_launcher_used,
    workspace_manifest: manifest,
    workspace_diff: manifest,
    child_processes_clean: output.exit_code() == expected_exit,
    semantic_ok,
  }
}

async fn main {
  let args = @env.args()
  guard args.length() == 1 else {
    fail("usage: moon run scripts/m5_replay.mbtx [set M5_REPLAY_REPETITIONS]")
  }
  let repetitions = match @env.get_env_var("M5_REPLAY_REPETITIONS") {
    Some(value) => try {
      match @json.parse(value) {
        Number(number, ..) if number >= 1 && number <= 100 => number.to_int()
        _ => 3
      }
    } catch {
      _ => 3
    }
    None => 3
  }
  let mbtx = match @env.get_env_var("M5_MBTX") {
    Some(path) => {
      guard @fs.exists(path) else {
        fail("M5_MBTX does not exist: " + path)
      }
      @fs.realpath(path)
    }
    None => {
      let build = @shell.Cmd(
        "moon",
        [
          "run", "--build-only", "--output-json", "--target", "native",
          "cmd/mbtx",
        ],
      ).output(timeout_ms=120_000)
      if build.exit_code() != 0 {
        fail(
          "native MBTX build failed with exit " +
          build.exit_code().to_string() +
          "\nstdout:\n" +
          build.stdout() +
          "\nstderr:\n" +
          build.stderr(),
        )
      }
      guard @json.parse(build.stdout()) is {
        "artifacts_path": [String(path)],
        ..
      } else {
        fail("missing native MBTX artifact")
      }
      path
    }
  }
  let launcher_build = @shell.Cmd(
    "cargo",
    [
      "build", "--locked", "--manifest-path", "adapter/Cargo.toml", "--bin",
      "m5-trace-launcher",
    ],
  ).output(timeout_ms=120_000)
  launcher_build.check()
  let launcher = @fs.realpath("adapter/target/debug/m5-trace-launcher")
  let base = @fs.tmpdir(prefix="m5-replay-")
  let trace_ids = traces()
  let runs : Array[ReplayRun] = []
  for repetition in 0..<repetitions {
    for trace_id in trace_ids {
      for backend in ["shell", "transparent"] {
        let workspace = base + "/" + trace_id + "-" + backend + "-" + repetition.to_string()
        @fs.mkdir(workspace, recursive=true)
        runs.push(run_trace(mbtx, launcher, trace_id, repetition, backend, workspace))
      }
    }
  }
  let mut mismatches = 0
  let mut trace_mismatches = 0
  for trace_id in trace_ids {
    for repetition in 0..<repetitions {
      let pair = runs.filter(r => r.trace_id == trace_id && r.repetition == repetition)
      if pair.length() == 2 && pair[0].semantic_ok != pair[1].semantic_ok {
        mismatches += 1
      }
      if pair.length() == 2 &&
        (normalized_stdout(pair[0]) != normalized_stdout(pair[1]) ||
          pair[0].stderr != pair[1].stderr ||
          pair[0].exit_code != pair[1].exit_code ||
          pair[0].result_json != pair[1].result_json ||
          pair[0].workspace_manifest != pair[1].workspace_manifest ||
          pair[0].argv != pair[1].argv ||
          pair[0].sandbox != pair[1].sandbox ||
          pair[0].approval_original_command != pair[1].approval_original_command ||
          pair[0].event_order != pair[1].event_order ||
          pair[0].process_trace != pair[1].process_trace ||
          !pair[0].launcher_trace.is_empty() || pair[0].transparent_launcher_used ||
          pair[1].launcher_trace != ["launcher_start", "launcher_exit"] ||
          !pair[1].transparent_launcher_used ||
          pair[0].workspace_diff != pair[1].workspace_diff ||
          !pair[0].child_processes_clean || !pair[1].child_processes_clean) {
        trace_mismatches += 1
      }
    }
  }
  let report : ReplayReport = {
    schema_version: 5,
    experiment: "m5-replay",
    implementation_sha: implementation_sha(),
    toolchain: toolchain(),
    platform: platform(),
    trace_count: trace_ids.length(),
    trajectory_count: trace_ids.length() * repetitions,
    repetitions,
    traces: trace_ids,
    runs,
    paired_semantic_mismatches: mismatches,
    paired_trace_mismatches: trace_mismatches,
  }
  if !@fs.exists("_build/m5-results") {
    @fs.mkdir("_build/m5-results", recursive=true)
  }
  let encoded = ToJson::to_json(report).stringify()
  @fs.write_file("_build/m5-results/replay.json", encoded)
  @fs.rmdir(base, recursive=true)
  println(encoded)
}
