import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/json",
}

async fn main {
  let build = @shell.Cmd(
    "moon",
    ["run", "--build-only", "--output-json", "--target", "native", "cmd/mbtx"],
  ).output()
  build.check()
  guard @json.parse(build.stdout()) is { "artifacts_path": [String(mbtx)], .. } else {
    fail("missing native MBTX artifact")
  }
  let build = @shell.Cmd("moon", ["run", "--build-only", "--output-json", "--target", "native", "cmd/m4-evidence"]).output()
  build.check()
  guard @json.parse(build.stdout()) is { "artifacts_path": [String(grader)], .. } else { fail("missing grader") }
  let output = @shell.Cmd(grader, ["suite"]).output()
  output.check()
  guard @json.parse(output.stdout()) is Array(cases) else { fail("invalid suite") }
  let plan = @shell.Cmd(grader, ["plan", "full", "18"]).output()
  plan.check()
  guard @json.parse(plan.stdout()) is { "planned_rollouts": 24, "start_rollout": 18, "rollouts": Array(slots), .. } else {
    fail("invalid continuation plan")
  }
  guard slots.length() == 6 && slots[0] is { "index": 18, "task": "literal_argv", "backend": "shell", "repetition": 2, .. } else {
    fail("continuation CLI did not preserve the full plan")
  }
  let evidence : Json = { "task": "json_totals", "backend": "shell", "events": "", "dumps": [], "requests": [], "result": Json::null(), "inputs": {}, "unexpected_file": false, "timeout": false, "exit_code": 1 }
  let graded = @shell.Cmd(grader, ["audit"], stdin=Text(evidence.stringify())).output()
  guard graded.exit_code() == 0 else { fail("evidence CLI failed: " + graded.stderr()) }
  guard @json.parse(graded.stdout()) is { "failure_category": "agent_error", .. } else { fail("incomplete evidence must not pass") }
  guard cases[0] is { "inputs": inputs, "expected": expected, .. } else { fail("missing totals fixture") }
  let response : Json = { "status": 200, "body": {
    "type": "response.completed", "response": { "id": "regression", "usage": { "input_tokens": 12, "output_tokens": 8 },
      "output": [{ "type": "function_call", "name": "exec_command", "call_id": "regression-call", "arguments": "{}" }] } } }
  // Exercise the CLI boundary: Option[String] used to encode a present file as [text].
  for result in [expected.stringify().to_json(), [expected.stringify()].to_json(), Json::null()] {
    let evidence : Json = { "task": "json_totals", "backend": "shell", "events": "{\"type\":\"turn.completed\"}\n",
      "dumps": [response.stringify().to_json()], "requests": [], "result": result, "inputs": inputs,
      "unexpected_file": false, "timeout": false, "exit_code": 0 }
    let graded = @shell.Cmd(grader, ["audit"], stdin=Text(evidence.stringify())).output()
    if result is Array(_) {
      guard graded.exit_code() != 0 && graded.stderr().contains("evidence.result must be a string or null") else { fail("array-wrapped result must be rejected as invalid evidence") }
    } else {
      guard graded.exit_code() == 0 else { fail("valid evidence CLI failed: " + graded.stderr()) }
      let output = @json.parse(graded.stdout())
      if result is String(_) {
        guard output is { "correct_output": true, "failure_category": "none", .. } else { fail("correct file contents must pass: " + graded.stdout()) }
      } else {
        guard output is { "correct_output": false, "failure_category": "incorrect_output", .. } else { fail("a completed turn without a result file must fail grading") }
      }
    }
  }
  let base = @fs.tmpdir(prefix="m4-fixtures-")
  let mut checked = 0
  for case in cases {
    guard case is { "id": String(id), "inputs": Object(inputs), "expected": expected, .. } else { fail("invalid case") }
    let workspace = "\{base}/\{id}"
    @fs.mkdir(workspace)
    for path, value in inputs {
      if !path.has_suffix(".mbtx") { continue }
      guard value is String(source) else { fail("invalid source") }
      let source = if id == "repair_moon" { source.replace(old="total = x", new="total += x") } else { source }
      @fs.write_file("\{workspace}/\{path}", source)
      let args = ["run", path]
      if id == "literal_argv" { args.append(["alpha beta", "quote'\"$", "$(touch SHOULD_NOT_EXIST)"]) }
      @shell.Cmd("moon", args, cwd=workspace).run(timeout_ms=30_000)
      let result = @json.parse(@fs.read_file("\{workspace}/result.json").text())
      guard result == expected else { fail("fixture \{id} produced an unexpected result: \{result.stringify()}") }
      guard !@fs.exists("\{workspace}/SHOULD_NOT_EXIST") else { fail("literal argv was expanded") }
      checked += 1
    }
  }
  guard checked == 3 else { fail("expected three executable fixtures") }
  @fs.rmdir(base, recursive=true)
  let transparent = @shell.Cmd(
    mbtx,
    ["exec", "--", "/bin/sh", "-c", "printf proxy-ok; printf proxy-err >&2; exit 7"],
  ).output()
  guard transparent.exit_code() == 7 else { fail("transparent launcher lost child exit status") }
  guard transparent.stdout() == "proxy-ok" && transparent.stderr() == "proxy-err" else {
    fail("transparent launcher did not preserve child streams")
  }
  println("M4 executable fixtures: 3 passed; evidence CLI regressions passed; no API key used")
}
