import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/json",
}

async fn main {
  let inline : Json = {
    "id": "inline",
    "op": "run",
    "source": "fn main { println(42) }",
  }
  let broken : Json = {
    "id": "broken",
    "op": "run",
    "source": "fn main { nonexistent_smoke_function() }",
  }
  let file : Json = {
    "id": "file",
    "op": "run",
    "script_path": "examples/hello.mbtx",
    "args": ["MBTX", "$(echo literal) | *"],
  }
  // The malformed record must not stop the stream; the last record has no LF.
  let input = "{bad JSON}\n\n" + inline.stringify() + "\n" +
    broken.stringify() + "\n" + file.stringify()
  let output = @shell.Cmd(
    "moon",
    ["run", "--quiet", "cmd/mbtx"],
    stdin=Text(input),
  ).output(timeout_ms=120_000)
  assert_eq(output.exit_code(), 0)
  let events : Array[Map[String, Json]] = []
  for line in output.stdout().trim().split("\n") {
    events.push(@json.from_json(@json.parse(line)))
  }
  assert_eq(events[0].get("event"), Some("failed".to_json()))
  assert_eq(events[0].get("id"), Some(Json::null()))
  let terminal_ids : Array[String] = []
  let streams : Array[(String, String)] = []
  for event in events {
    let kind : String = @json.from_json(event.get("event").unwrap())
    if kind == "completed" {
      let id : String = @json.from_json(event.get("id").unwrap())
      let code : Int = @json.from_json(event.get("exit_code").unwrap())
      let duration : Int = @json.from_json(event.get("duration_ms").unwrap())
      assert_true(duration >= 0)
      if id == "broken" {
        assert_true(code != 0)
      } else {
        assert_eq(code, 0)
      }
      terminal_ids.push(id)
    } else if kind == "stdout" {
      streams.push((
        @json.from_json(event.get("id").unwrap()),
        @json.from_json(event.get("data").unwrap()),
      ))
    }
  }
  assert_eq(terminal_ids, ["inline", "broken", "file"])
  assert_eq(streams, [
    ("inline", "42\n"),
    ("file", "Hello, MBTX!\nHello, $(echo literal) | *!\n"),
  ])
  println("MBTX JSONL smoke test passed")
}
