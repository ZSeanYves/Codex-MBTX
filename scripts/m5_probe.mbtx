import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

/// A recorded probe attempt. The probe collector is intentionally offline:
/// production runners may feed it redacted HTTP/SSE records without giving
/// the evaluator permission to issue network requests.
struct Probe {
  attempt_id : String
  retry_index : Int
  arm : String
  time_window : Int
  // Keep nullable wire fields as Json at this boundary.  MoonBit's derived
  // struct decoder treats nullable primitive fields differently from the
  // top-level Option decoder; accepting Json lets us audit both canonical
  // `number|null` records and legacy one-element Option arrays without
  // dropping a probe or turning it into an unexplained parser failure.
  http_status : Json
  first_byte_ms : Json
  completed_ms : Json
  stream_disconnected : Bool
  provider_error : Bool
  transport_error : Bool
  usage_complete : Bool
  error_class : Json
  malformed : Bool
} derive(FromJson, ToJson)

fn optional_int(value : Json) -> Int? {
  match value {
    Null => None
    Number(number, ..) => Some(number.to_int())
    Array([inner]) => optional_int(inner)
    _ => None
  }
}

fn normalize_probe(value : Json) -> Json {
  match value {
    Object(fields) => {
      // A truncated curl diagnostic is still evidence.  Fill only omitted
      // fields with schema-safe sentinels so the aggregate can report an
      // invalid/unsuccessful probe instead of crashing before writing its
      // health artifact.
      let mut missing = false
      if fields.get("attempt_id") is None {
        fields["attempt_id"] = ""
        missing = true
      }
      if fields.get("retry_index") is None {
        fields["retry_index"] = 0
        missing = true
      }
      if fields.get("arm") is None {
        fields["arm"] = ""
        missing = true
      }
      if fields.get("time_window") is None {
        fields["time_window"] = 0
        missing = true
      }
      if fields.get("http_status") is None {
        fields["http_status"] = Json::null()
        missing = true
      }
      if fields.get("first_byte_ms") is None {
        fields["first_byte_ms"] = Json::null()
        missing = true
      }
      if fields.get("completed_ms") is None {
        fields["completed_ms"] = Json::null()
        missing = true
      }
      if fields.get("stream_disconnected") is None {
        fields["stream_disconnected"] = false
        missing = true
      }
      if fields.get("provider_error") is None {
        fields["provider_error"] = false
        missing = true
      }
      if fields.get("transport_error") is None {
        fields["transport_error"] = false
        missing = true
      }
      if fields.get("usage_complete") is None {
        fields["usage_complete"] = false
        missing = true
      }
      if fields.get("error_class") is None {
        fields["error_class"] = Json::null()
        missing = true
      }
      let prior_malformed = match fields.get("malformed") {
        Some(True) => true
        _ => false
      }
      fields["malformed"] = (missing || prior_malformed).to_json()
      Json::object(fields)
    }
    _ => value
  }
}

fn percentile(values : Array[Int], p : Int) -> Int {
  if values.is_empty() { return 30_000 }
  let sorted = values.copy()
  sorted.sort()
  // Use the conservative nearest-rank definition. With the preregistered
  // 9/10 success floor, p95 is therefore the slowest observed first byte,
  // rather than silently discarding one of only nine measurements.
  let rank = (sorted.length() * p + 99) / 100
  sorted[rank - 1]
}

fn is_provider_failure(probe : Probe) -> Bool {
  probe.provider_error || (match optional_int(probe.http_status) {
    Some(status) => status >= 400
    None => false
  })
}

fn is_transport_failure(probe : Probe) -> Bool {
  probe.transport_error || probe.stream_disconnected
}

fn is_success(probe : Probe) -> Bool {
  let arm_ok = probe.arm == "shell" || probe.arm == "transparent"
  let window_ok = probe.time_window > 0
  let status_ok = match optional_int(probe.http_status) {
    Some(status) => status >= 200 && status < 300
    None => false
  }
  let completed_ok = optional_int(probe.completed_ms) is Some(_)
  arm_ok && window_ok && !is_provider_failure(probe) &&
    !is_transport_failure(probe) && status_ok &&
    completed_ok && probe.usage_complete
}

/// The operational policy keeps the strict health result intact but allows a
/// small amount of relay noise so a slow upstream does not discard an
/// otherwise comparable paired batch. This is intentionally a probe-level
/// continuation rule, not a backend success rule.
fn operational_health_valid(
  probes : Int,
  successful : Int,
  provider : Int,
  transport : Int,
  max_consecutive : Int,
  arm_failure_rate : Int,
  shell_successful : Int,
  transparent_successful : Int,
  malformed : Bool,
  windows : Int,
) -> Bool {
  probes >= 10 &&
  successful >= 8 &&
  provider <= 1 &&
  provider + transport <= 2 &&
  max_consecutive <= 2 &&
  arm_failure_rate <= 5_000 &&
  shell_successful >= 3 &&
  transparent_successful >= 3 &&
  !malformed &&
  windows >= 1
}

fn health(probes : Array[Probe]) -> Json {
  let mut successful = 0
  let mut provider = 0
  let mut transport = 0
  let mut consecutive = 0
  let mut max_consecutive = 0
  let first_bytes : Array[Int] = []
  let windows : Array[Int] = []
  let mut shell_total = 0
  let mut transparent_total = 0
  let mut shell_failures = 0
  let mut transparent_failures = 0
  let mut malformed = false
  for probe in probes {
    if probe.malformed { malformed = true }
    if (probe.arm != "shell" && probe.arm != "transparent") ||
      probe.time_window <= 0 {
      malformed = true
    }
    if !windows.contains(probe.time_window) { windows.push(probe.time_window) }
    if probe.arm == "shell" { shell_total += 1 }
    if probe.arm == "transparent" { transparent_total += 1 }
    match optional_int(probe.first_byte_ms) {
      Some(value) => first_bytes.push(value)
      None => ()
    }
    if is_success(probe) {
      successful += 1
      consecutive = 0
    } else {
      consecutive += 1
      if consecutive > max_consecutive { max_consecutive = consecutive }
      if is_provider_failure(probe) { provider += 1 }
      if is_transport_failure(probe) { transport += 1 }
      if probe.arm == "shell" { shell_failures += 1 }
      if probe.arm == "transparent" { transparent_failures += 1 }
    }
  }
  let shell_rate = if shell_total == 0 {
    10_000
  } else {
    shell_failures * 10_000 / shell_total
  }
  let transparent_rate = if transparent_total == 0 {
    10_000
  } else {
    transparent_failures * 10_000 / transparent_total
  }
  let arm_failure_rate = if malformed {
    10_000
  } else {
    (shell_rate - transparent_rate).abs()
  }
  let shell_successful = shell_total - shell_failures
  let transparent_successful = transparent_total - transparent_failures
  let strict_valid = probes.length() >= 10 && successful >= 9 &&
    provider + transport <= 1 && max_consecutive < 2 &&
    percentile(first_bytes, 95) <= 15_000 &&
    !malformed && windows.length() >= 1
  let operational_valid = operational_health_valid(
    probes.length(),
    successful,
    provider,
    transport,
    max_consecutive,
    arm_failure_rate,
    shell_successful,
    transparent_successful,
    malformed,
    windows.length(),
  )
  let health : Json = {
    "probes": probes.length().to_json(),
    "successful_probes": successful.to_json(),
    "provider_errors": provider.to_json(),
    "transport_errors": transport.to_json(),
    "max_consecutive_failures": max_consecutive.to_json(),
    "first_byte_p95_ms": percentile(first_bytes, 95).to_json(),
    "arm_failure_rate_basis_points": arm_failure_rate.to_json(),
    "time_windows": windows.length().to_json(),
    "shell_probes": shell_total.to_json(),
    "transparent_probes": transparent_total.to_json(),
    "shell_successful_probes": shell_successful.to_json(),
    "transparent_successful_probes": transparent_successful.to_json(),
  }
  {
    "schema_version": 5,
    "health": health,
    // `health_valid` is the original preregistered strict result.  The
    // operational result is separate and is only used by an explicitly
    // configured online collection policy.
    "health_valid": strict_valid,
    "health_usable": operational_valid,
    "latency_degraded": (percentile(first_bytes, 95) > 15_000),
    "health_policy": "strict+operational",
    "attempts": probes.to_json(),
  }
}

async fn main {
  let args = @env.args()
  guard args.length() <= 2 else {
    fail("usage: moon run scripts/m5_probe.mbtx [PROBE_JSON_FILE]")
  }
  let text = if args.length() == 2 {
    @fs.read_file(args[1]).text()
  } else {
    @stdio.stdin.read_all().text()
  }
  let parsed = @json.parse(text)
  let normalized = match parsed {
    Array(values) => Json::array(values.map(normalize_probe))
    _ => parsed
  }
  let probes : Array[Probe] = @json.from_json(normalized)
  let output = health(probes)
  if !@fs.exists("_build/m5-results") {
    @fs.mkdir("_build/m5-results", recursive=true)
  }
  let probe_output = @env.get_env_var("M5_PROBE_HEALTH_OUTPUT").unwrap_or(
    "_build/m5-results/probe-health.json",
  )
  let relay_output = @env.get_env_var("M5_RELAY_HEALTH_OUTPUT").unwrap_or(
    "_build/m5-results/relay-health.json",
  )
  @fs.write_file(probe_output, output.stringify())
  match output {
    { "health": health, .. } =>
      @fs.write_file(relay_output, health.stringify())
    _ => ()
  }
  println(output.stringify())
}
