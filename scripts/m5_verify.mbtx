import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

fn field(value : Json, key : String) -> Json? {
  match value {
    Object(fields) => fields.get(key)
    _ => None
  }
}

fn string_field(value : Json, key : String) -> String {
  match field(value, key) {
    Some(String(text)) => text
    _ => ""
  }
}

fn number_field(value : Json, key : String) -> Int {
  match field(value, key) {
    Some(Number(number, ..)) => number.to_int()
    _ => -1
  }
}

fn runtime_pair_schedule_valid(samples : Array[Json]) -> Bool {
  if samples.length() % 2 != 0 { return false }
  let mut offset = 0
  while offset < samples.length() {
    let left = samples[offset]
    let right = samples[offset + 1]
    let index = number_field(left, "sample_index")
    let order = if index % 2 == 0 { "AB" } else { "BA" }
    let first_backend = if order == "AB" { "shell" } else { "bare-proxy" }
    let second_backend = if order == "AB" { "bare-proxy" } else { "shell" }
    if index < 0 || index != number_field(right, "sample_index") ||
      string_field(left, "scenario") != string_field(right, "scenario") ||
      string_field(left, "phase") != string_field(right, "phase") ||
      string_field(left, "pair_order") != order ||
      string_field(right, "pair_order") != order ||
      string_field(left, "backend") != first_backend ||
      string_field(right, "backend") != second_backend ||
      number_field(left, "pair_position") != 0 ||
      number_field(right, "pair_position") != 1 {
      return false
    }
    offset += 2
  }
  true
}

async fn main {
  let args = @env.args()
  guard args.length() == 1 else {
    fail("usage: moon run scripts/m5_verify.mbtx")
  }
  let live_probe_build = @shell.Cmd(
    "moon",
    ["run", "--build-only", "scripts/m5_live_probe.mbtx"],
  ).output(timeout_ms=120_000)
  live_probe_build.check()
  if !@fs.exists("_build/m5-results") {
    @fs.mkdir("_build/m5-results", recursive=true)
  }
  for _ in 0..<2 {
    let prepare_probe_directory = @shell.Cmd(
      "moon",
      ["run", "scripts/m5_live_probe.mbtx", "--prepare-results-dir"],
    ).output(timeout_ms=120_000)
    prepare_probe_directory.check()
  }
  let build = @shell.Cmd(
    "moon",
    ["run", "--build-only", "--output-json", "--target", "native", "cmd/m5-evidence"],
  ).output(timeout_ms=120_000)
  build.check()
  guard @json.parse(build.stdout()) is { "artifacts_path": [String(evidence)], .. } else {
    fail("missing m5-evidence artifact")
  }
  let suite = @shell.Cmd(evidence, ["suite", "all"]).output()
  suite.check()
  guard @json.parse(suite.stdout()) is Array(tasks) && tasks.length() == 14 else {
    fail("M5 suite must contain 8 process and 6 script tasks")
  }
  let plan = @shell.Cmd(evidence, ["plan", "pilot", "17", "0", "1"]).output()
  plan.check()
  guard @json.parse(plan.stdout()) is {
    "schema_version": 5,
    "planned_blocks": 8,
    "blocks": Array(blocks),
    ..
  } && blocks.length() == 8 else {
    fail("M5 planner output is not versioned or complete")
  }
  let health = @shell.Cmd(
    evidence,
    ["health"],
    stdin=@shell.Stdin::Text("{\"probes\":10,\"successful_probes\":10,\"provider_errors\":0,\"transport_errors\":0,\"max_consecutive_failures\":0,\"first_byte_p95_ms\":1200,\"arm_failure_rate_basis_points\":0,\"time_windows\":3}"),
  ).output()
  health.check()
  guard @json.parse(health.stdout()) is { "health_valid": true, "batch_valid": true, .. } else {
    fail("healthy relay fixture was rejected")
  }
  let probe_only = @shell.Cmd(
    evidence,
    ["health"],
    stdin=@shell.Stdin::Text("{\"probes\":10,\"successful_probes\":9,\"provider_errors\":1,\"transport_errors\":0,\"max_consecutive_failures\":1,\"first_byte_p95_ms\":1200,\"arm_failure_rate_basis_points\":0,\"time_windows\":3}"),
  ).output()
  probe_only.check()
  guard @json.parse(probe_only.stdout()) is {
    "health_valid": true,
    "batch_valid": false,
    ..
  } else {
    fail("probe gate incorrectly applied the post-batch 5% rule")
  }
  let probe_records : Array[Json] = []
  for i in 0..<10 {
    probe_records.push({
      "attempt_id": "probe-" + i.to_string(),
      "retry_index": 0,
      "arm": if i % 2 == 0 { "shell" } else { "transparent" },
      "time_window": (i % 3) + 1,
      // Exercise the actual nullable wire representation used by the live
      // collector: None must be JSON null, not a one-element Option array.
      "http_status": if i == 0 { Json::null() } else { 200 },
      "first_byte_ms": if i == 0 { Json::null() } else { 1_200 + i },
      "completed_ms": if i == 0 { Json::null() } else { 1_300 + i },
      "stream_disconnected": false,
      "provider_error": i == 0,
      "transport_error": false,
      "usage_complete": i != 0,
      "error_class": Json::null(),
      "malformed": false,
    })
  }
  let probe = @shell.Cmd(
    "moon",
    ["run", "scripts/m5_probe.mbtx"],
    stdin=@shell.Stdin::Text(probe_records.to_json().stringify()),
  ).output(timeout_ms=120_000)
  probe.check()
  guard @json.parse(probe.stdout()) is { "schema_version": 5, "health_valid": true, .. } else {
    fail("recorded relay probes were not aggregated into a valid health artifact")
  }
  let slow_probe_records = probe_records.copy()
  slow_probe_records[9] = {
    "attempt_id": "probe-9",
    "retry_index": 0,
    "arm": "transparent",
    "time_window": 1,
    "http_status": 200,
    "first_byte_ms": 15_001,
    "completed_ms": 15_100,
    "stream_disconnected": false,
    "provider_error": false,
    "transport_error": false,
    "usage_complete": true,
    "error_class": Json::null(),
    "malformed": false,
  }
  let slow_probe = @shell.Cmd(
    "moon",
    ["run", "scripts/m5_probe.mbtx"],
    stdin=@shell.Stdin::Text(slow_probe_records.to_json().stringify()),
  ).output(timeout_ms=120_000)
  slow_probe.check()
  guard @json.parse(slow_probe.stdout()) is {
    "health": { "first_byte_p95_ms": 15001, .. },
    "health_valid": false,
    ..
  } else {
    fail("small-sample probe p95 did not use the conservative nearest rank")
  }
  // Legacy collector records used MoonBit's one-element Option arrays.  Keep
  // them readable while the canonical live wire format remains number|null.
  let legacy_probe = @shell.Cmd(
    "moon",
    ["run", "scripts/m5_probe.mbtx"],
    stdin=@shell.Stdin::Text("[{\"attempt_id\":\"legacy\",\"retry_index\":0,\"arm\":\"shell\",\"time_window\":1,\"http_status\":[200],\"first_byte_ms\":[10],\"completed_ms\":[20],\"stream_disconnected\":false,\"provider_error\":false,\"transport_error\":false,\"usage_complete\":true,\"error_class\":null}]"),
  ).output(timeout_ms=120_000)
  legacy_probe.check()
  guard @json.parse(legacy_probe.stdout()) is { "schema_version": 5, .. } else {
    fail("legacy Option-array probe records are not parseable")
  }
  let classified = @shell.Cmd(
    evidence,
    ["classify"],
    stdin=@shell.Stdin::Text("{\"relay_status\":\"clean\",\"observability\":\"complete\",\"backend_observation\":\"unknown\",\"completed\":true,\"usage_complete\":true,\"correct_output\":true,\"inputs_preserved\":true,\"workspace_clean\":true,\"child_processes_clean\":true,\"receipt_valid\":true,\"trace_complete\":true,\"argv_cwd_valid\":true,\"approval_original_command\":true,\"timeout\":false}"),
  ).output()
  classified.check()
  guard @json.parse(classified.stdout()) is { "failure_category": "none", .. } else {
    fail("unknown backend observation was converted into a violation")
  }
  let audited = @shell.Cmd(
    evidence,
    ["audit"],
    stdin=@shell.Stdin::Text("{\"events\":\"\",\"dumps\":[],\"requests\":[\"{\\\"id\\\":\\\"audit-request\\\",\\\"model\\\":\\\"test\\\"}\"],\"transport_error\":false,\"stream_complete\":false,\"backend_observed\":false,\"backend_compliant\":false}"),
  ).output()
  audited.check()
  guard @json.parse(audited.stdout()) is {
    "relay_status": "clean",
    "observability": "unobserved",
    "backend_observation": "unknown",
    ..
  } else {
    fail("M5 audit state boundaries are not preserved")
  }
  let legacy = @shell.Cmd(
    evidence,
    ["legacy"],
    stdin=@shell.Stdin::Text("{\"schema_version\":4,\"results\":[]}"),
  ).output()
  legacy.check()
  guard @json.parse(legacy.stdout()) is { "schema_version": 4, "parseable": true, .. } else {
    fail("historical M4 schema is no longer parseable")
  }
  for historical_path in [
    "docs/reports/m4-2026-09-08/34205871080.json",
    "docs/reports/m4-2026-09-09/34251123220.json",
  ] {
    guard @fs.exists(historical_path) else {
      fail("missing historical M4 fixture: " + historical_path)
    }
    let historical = @shell.Cmd(
      evidence,
      ["legacy"],
      stdin=@shell.Stdin::Text(@fs.read_file(historical_path).text()),
    ).output()
    historical.check()
    guard @json.parse(historical.stdout()) is {
      "schema_version": Number(version, ..),
      "parseable": true,
      ..
    } && version < 5.0 else {
      fail("historical M4 artifact was not accepted: " + historical_path)
    }
  }
  let runtime = @shell.Cmd(
    "moon",
    ["run", "scripts/m5_runtime.mbtx"],
    env={
      "M5_COLD_RUNS": "2",
      "M5_WARM_RUNS": "2",
      "M5_CHILD_START_DELAY_MS": "200",
    },
  ).output(timeout_ms=120_000)
  runtime.check()
  guard @json.parse(runtime.stdout()) is {
    "schema_version": 5,
    "schedule": "paired-alternating-ab-ba",
    "samples": Array(runtime_samples),
    "pair_summaries": Array(pair_summaries),
    ..
  } && runtime_samples.length() == 72 && pair_summaries.length() == 18 &&
  runtime_samples.all(sample => match sample {
    {
      "content_ok": true,
      "child_start_marker": true,
      "cancellation_scope": String(scope),
      "cancellation_grace_ms": Number(grace, ..),
      "lifecycle_status": String(lifecycle),
      ..
    } => if lifecycle == "stop" || lifecycle == "timeout" || lifecycle == "cancel" {
      scope == "process-group" && grace == 50.0
    } else {
      scope == "none" && grace == 0.0
    }
    _ => false
  }) && runtime_pair_schedule_valid(runtime_samples) else {
    fail("M5 runtime artifact is not versioned")
  }
  let replay = @shell.Cmd(
    "moon",
    ["run", "scripts/m5_replay.mbtx"],
    env={ "M5_REPLAY_REPETITIONS": "1" },
  ).output(timeout_ms=120_000)
  replay.check()
  guard @json.parse(replay.stdout()) is {
    "schema_version": 5,
    "paired_semantic_mismatches": 0,
    "paired_trace_mismatches": 0,
    ..
  } else {
    fail("M5 replay trace comparison is not clean")
  }
  let faults = @shell.Cmd("moon", ["run", "scripts/m5_faults.mbtx"]).output(timeout_ms=120_000)
  faults.check()
  let synthetic = @shell.Cmd("moon", ["run", "scripts/m5_synthetic.mbtx"]).output(timeout_ms=120_000)
  synthetic.check()
  let isolated_state = @fs.tmpdir(prefix="m5-verify-state-")
  defer @fs.rmdir(isolated_state, recursive=true)
  let eval = @shell.Cmd(
    "moon",
    ["run", "scripts/m5_eval.mbtx", "pilot"],
    env={
      "M5_DETERMINISTIC_MANIFEST": isolated_state + "/missing-manifest.json",
    },
  ).output(timeout_ms=120_000)
  eval.check()
  let analyze = @shell.Cmd("moon", ["run", "scripts/m5_analyze.mbtx"]).output(timeout_ms=120_000)
  analyze.check()
  guard @fs.exists("_build/m5-results/runtime.json") &&
    @fs.exists("_build/m5-results/replay.json") &&
    @fs.exists("_build/m5-results/faults.json") &&
    @fs.exists("_build/m5-results/report.json") &&
    @fs.exists("_build/m5-results/report.md") &&
    @fs.exists("_build/m5-results/pairs.csv") else {
    fail("M5 verification artifacts are incomplete")
  }
  guard @json.parse(@fs.read_file("_build/m5-results/report.json").text()) is {
    "schema_version": 5,
    "mode": "pilot",
    "decision": { "status": "INCONCLUSIVE", .. },
    "validity": {
      "confidence_intervals_computed": false,
      "block_health_valid": false,
      "deterministic_manifest_valid": false,
      "relay_clean_conditional": false,
      "token_metrics_available": false,
      ..
    },
    ..
  } else {
    fail("pilot without a runner must remain INCONCLUSIVE and CI-unavailable")
  }
  let healthy_relay = isolated_state + "/healthy-relay.json"
  @fs.write_file(
    healthy_relay,
    "{\"probes\":10,\"successful_probes\":10,\"provider_errors\":0,\"transport_errors\":0,\"max_consecutive_failures\":0,\"first_byte_p95_ms\":1200,\"arm_failure_rate_basis_points\":0,\"time_windows\":1}",
  )
  let failed_runner = @shell.Cmd(
    "moon",
    ["run", "scripts/m5_eval.mbtx", "pilot"],
    env={
      "M5_DETERMINISTIC_MANIFEST": isolated_state + "/missing-manifest.json",
      "M5_RELAY_HEALTH_FILE": healthy_relay,
      "M5_RUNNER": "/usr/bin/false",
      "M5_BLOCK_LIMIT": "1",
    },
  ).output(timeout_ms=120_000)
  guard failed_runner.exit_code() != 0 else {
    fail("M5 runner failure did not fail the evaluation process")
  }
  guard @json.parse(@fs.read_file("_build/m5-results/report.json").text()) is {
    "schema_version": 5,
    "blocks": [],
    "runs": [],
    "aggregates": { "runner_errors": 1, .. },
    "decision": { "status": "INCONCLUSIVE", .. },
    ..
  } else {
    fail("M5 runner failure did not preserve an auditable report")
  }
  println("M5 offline verification passed: planner, health gate, classification, runtime, replay, faults and inconclusive online gate")
}
