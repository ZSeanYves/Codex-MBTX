import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}

async fn run(program : String, args : Array[String]) -> Unit {
  let result = @shell.Cmd(program, args).output(timeout_ms=1_800_000)
  if result.exit_code() != 0 { fail("command failed: \{program}\n\{result.stdout()}\n\{result.stderr()}") }
}

async fn main {
  let system = @shell.Cmd("uname", ["-s"]).output().stdout().trim()
  guard system == "Darwin" else { fail("collect-macos.mbtx must run on macOS") }
  let root = @fs.realpath(".")
  let output = @env.args().get(1).unwrap_or("_build/launcher-evidence-macos")
  @fs.mkdir(output, recursive=true)
  println("[macOS] building launcher and observer once")
  run("moon", ["run", "--build-only", "--output-json", "--target", "native", "cmd/mbtx"])
  run("cargo", ["build", "--locked", "--manifest-path", "adapter/Cargo.toml", "--bins"])
  let launcher = "\{root}/_build/native/debug/build/cmd/mbtx/mbtx.exe"
  let evaluator = "\{root}/adapter/target/debug/mbtx-eval"
  guard @fs.exists(launcher) && @fs.exists(evaluator) else { fail("native artifacts were not produced") }
  println("[macOS] collecting eight task classes with AB/BA ordering")
  run(evaluator, ["run", "--mbtx", launcher, "--pairs", "4", "--output", output])
  let html = @shell.Cmd(evaluator, ["report", "--events", "\{output}/events.jsonl", "--format", "html"]).output()
  @fs.write_file("\{output}/report.html", html.stdout())
  println("[macOS] complete: \{output}/events.jsonl and \{output}/report.html")
  println("[macOS] use Linux output for the primary online Codex collection; keep this platform separate")
}
