import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

async fn main {
  let system = @shell.Cmd("uname", ["-s"]).output()
  guard system.stdout().trim() == "Linux" else { fail("Linux is required") }
  @shell.Cmd("moon", ["run", "scripts/collect.mbtx", "launcher"] + @env.args()[1:].to_owned()).run()
}
