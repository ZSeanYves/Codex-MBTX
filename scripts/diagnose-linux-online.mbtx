import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

async fn inspect_command(program : String, arguments : Array[String], cwd : String) -> Json {
  try {
    let result = @shell.Cmd(program, arguments, cwd~).output(timeout_ms=120000)
    {"command":program.to_json(), "arguments":arguments.to_json(), "exit_code":result.exit_code().to_json(), "stdout":result.stdout().to_json(), "stderr":result.stderr().to_json()}
  } catch { error => {"command":program.to_json(), "exit_code":Json::null(), "error":error.to_string().to_json()} }
}

async fn main {
  let root = @fs.realpath(".")
  let output = @env.args().get(1).unwrap_or("diagnostics/linux-online-\{@async.now()}")
  @fs.mkdir(output, recursive=true)
  let results = [
    inspect_command("uname", ["-a"], root),
    inspect_command("moon", ["--version"], root),
    inspect_command("rustc", ["-vV"], root),
    inspect_command("cargo", ["--version"], root),
  ]
  let bundle = @env.get_env_var("MBTX_BUNDLE")
  if bundle is Some(path) {
    let path = @fs.realpath(path)
    results.push(inspect_command("sha256sum", ["--check", "binaries.sha256"], path))
    results.push(inspect_command(path + "/codex-exec", ["--version"], root))
  }
  if @env.args().get(2) is Some(run) && bundle is Some(path) {
    results.push(inspect_command(path + "/mbtx-eval", ["report", run, "--format", "json", "--evaluation-model", path + "/evaluation-model"], root))
  }
  let key_present = @env.get_env_var("OPENAI_API_KEY") is Some(key) && key != ""
  let report : Json = {"schema_version":2, "api_key_present":key_present, "network_requests":0,
    "bundle":bundle.to_json(), "checks":results.to_json()}
  @fs.write_file(output + "/diagnostic.json", report.stringify(), create_mode=@fs.CreateMode::CreateNew)
  println("[diagnostic] \{output}/diagnostic.json; no API request sent")
}
