import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

async fn main {
  guard @env.get_env_var("OPENROUTER_ICU_API_KEY") is Some(key) && !key.is_empty() else { fail("repository API secret is missing") }
  @env.unset_env_var("OPENROUTER_ICU_API_KEY")
  guard !key.contains("\n") && !key.contains("\r") else { fail("repository secret must contain only the raw API key") }
  let model = @env.get_env_var("M4_MODEL").unwrap_or("gpt-5.6-terra")
  let build = @shell.Cmd("moon", ["run", "--build-only", "--output-json", "--target", "native", "cmd/m4-evidence"]).output()
  build.check()
  guard @json.parse(build.stdout()) is { "artifacts_path": [String(grader)], .. } else { fail("missing evidence binary") }
  let request : Json = { "model": model.to_json(), "input": "Reply with OK.", "stream": true, "store": false, "max_output_tokens": 128 }
  let temporary = @fs.tmpdir(prefix="m4-probe-")
  let started = @async.now()
  let output = @shell.Cmd("curl", ["--silent", "--show-error", "--fail-with-body", "--max-time", "60", "--connect-timeout", "15",
    "--request", "POST", "https://tokenadvent.com/v1/responses", "--header", "Content-Type: application/json",
    "--header", "Authorization: Bearer " + key, "--data-binary", "@-", "--max-filesize", "1048576", "--output", "\{temporary}/body", "--write-out", "%{json}"],
    stdin=Text(request.stringify()), inherit_env=false, env={ "PATH": "/usr/bin:/bin" }).output(timeout_ms=65_000, max_output_bytes=65_536)
  // This diagnostic runs before any untrusted agent exists. Never log the command/header.
  let body = if @fs.exists("\{temporary}/body") { @fs.read_file("\{temporary}/body").text().replace(old=key, new="[REDACTED]") } else { "" }
  let transport = @json.parse(output.stdout())
  guard transport is { "http_code": status, "time_total": total, "time_starttransfer": first_byte, .. } else { fail("invalid curl diagnostics") }
  let dump : Json = { "status": status, "body": body.to_json() }
  let parsed = @shell.Cmd(grader, ["probe"], stdin=Text(dump.stringify())).output()
  parsed.check()
  let audit = @json.parse(parsed.stdout())
  let report : Json = { "model": model.to_json(), "elapsed_ms": (@async.now() - started).to_double().to_json(),
    "curl_exit": output.exit_code().to_json(), "http_status": status, "time_total_s": total, "time_first_byte_s": first_byte,
    "audit": audit, "body_length": body.length().to_json(),
    "transport_error": output.stderr().replace(old=key, new="[REDACTED]").to_json() }
  @fs.mkdir("_build/m4-results", recursive=true)
  @fs.write_file("_build/m4-results/probe.json", report.stringify(indent=2))
  println(report.stringify(indent=2))
  @fs.rmdir(temporary, recursive=true)
  guard output.exit_code() == 0 else { fail("relay transport probe failed; see probe.json") }
  guard audit is { "responses": Number(responses, ..), .. } && responses > 0 else { fail("relay returned no completed response; see probe.json") }
}
