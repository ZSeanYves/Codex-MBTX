import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/process",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
}

async fn send(writer : @process.WriteToProcess, value : Json) -> Unit {
  writer.write(value.stringify() + "\n")
}

async fn receive(reader : @process.ReadFromProcess, id : String, kind : String) -> Json {
  for ;; {
    let line = reader.read_until("\n").unwrap()
    let event = @json.parse(line)
    if event is { "id": String(event_id), "event": String(event_kind), .. } &&
      event_id == id && event_kind == kind { return event }
  }
}

async fn exercise(target : String) -> Unit {
  let build = @shell.Cmd("moon", [
    "run", "--build-only", "--output-json", "--target", target, "cmd/mbtx",
  ]).output(timeout_ms=120_000)
  build.check()
  guard @json.parse(build.stdout()) is { "artifacts_path": [String(artifact)], .. } else {
    fail("missing runner artifact")
  }
  @async.with_timeout(20000, () => @async.with_task_group() <| group => {
    let (stdin, writer) = @process.write_to_process()
    defer writer.close()
    let (reader, stdout) = @process.read_from_process()
    defer reader.close()
    let (errors, stderr) = @process.read_from_process()
    defer errors.close()
    let child = @process.spawn(
      group, if target == "native" { artifact } else { "moonrun" },
      if target == "native" { [] } else { ["--", artifact] },
      stdin~, stdout~, stderr~, cancel_handler=@process.hard_cancel(),
    )
    let error_text = group.spawn(() => errors.read_all().text())
    let source =
      #|import { "moonbitlang/async", "moonbitlang/async/stdio" }
      #|async fn main {
      #|  @stdio.stdout.write("ready")
      #|  @async.sleep(60000)
      #|}
    send(writer, { "id": "bg", "op": "run", "source": source.to_json(), "background": true })
    let started = receive(reader, "bg", "started")
    guard started is { "job_id": String(job_id), .. } else { fail("missing job ID") }
    assert_true(receive(reader, "bg", "stdout") is { "data": "ready", "seq": 0, .. })
    send(writer, { "id": "query", "op": "job_output", "job_id": job_id.to_json() })
    assert_true(receive(reader, "query", "job_output") is { "state": "running", "next_cursor": 1, .. })
    send(writer, { "id": "quick", "op": "run", "source": "fn main { println(42) }" })
    assert_true(receive(reader, "quick", "completed") is { "exit_code": 0, .. })
    send(writer, { "id": "stop", "op": "job_stop", "job_id": job_id.to_json() })
    receive(reader, "bg", "stopped") |> ignore
    send(writer, { "id": "done", "op": "job_output", "job_id": job_id.to_json(), "cursor": 1 })
    assert_true(receive(reader, "done", "job_output") is { "state": "stopped", "chunks": [], .. })
    send(writer, { "id": "timeout", "op": "run", "source": source.to_json(), "timeout_ms": 2000 })
    assert_true(receive(reader, "timeout", "failed") is { "job_id": String(_), "error": { "kind": "timeout", .. }, .. })
    writer.close()
    assert_eq(child.wait(), 0)
    assert_eq(error_text.wait(), "")
  })
}

async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  assert_true(target == "wasm" || target == "native")
  exercise(target)
  println("MBTX job lifecycle smoke test passed (\{target})")
}
