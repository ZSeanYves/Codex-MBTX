import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

struct FaultResult {
  fault_id : String
  passed : Bool
  observed : Json
} derive(ToJson)

struct FaultReport {
  schema_version : Int
  experiment : String
  results : Array[FaultResult]
  artifact_retained : Bool
} derive(ToJson)

async fn main {
  let args = @env.args()
  guard args.length() == 1 else {
    fail("usage: moon run scripts/m5_faults.mbtx")
  }
  let build = @shell.Cmd(
    "moon",
    ["run", "--build-only", "--output-json", "--target", "native", "cmd/m5-evidence"],
  ).output(timeout_ms=120_000)
  build.check()
  guard @json.parse(build.stdout()) is { "artifacts_path": [String(binary)], .. } else {
    fail("missing native m5-evidence binary")
  }
  let faults : Array[(String, Json, String)] = [
    (
      "http-502",
      [{
        "attempt_id": "a1", "retry_index": 0, "http_status": 502,
        "started_ms": 0, "completed_ms": 10,
        "stream_disconnected": false, "provider_error": true, "recovered": false,
        "input_tokens": 0, "cached_input_tokens": 0, "output_tokens": 0,
        "usage_complete": false, "error_class": "http_502",
      }],
      "provider_errors",
    ),
    (
      "http-429-recovered",
      [
        {
          "attempt_id": "a1", "retry_index": 0, "http_status": 429,
          "started_ms": 0, "completed_ms": 10,
          "stream_disconnected": false, "provider_error": true, "recovered": false,
          "input_tokens": 0, "cached_input_tokens": 0, "output_tokens": 0,
          "usage_complete": false, "error_class": "retry_after",
        },
        {
          "attempt_id": "a2", "retry_index": 1, "http_status": 200,
          "started_ms": 20, "first_byte_ms": 22, "completed_ms": 40,
          "stream_disconnected": false, "provider_error": false, "recovered": true,
          "input_tokens": 3, "cached_input_tokens": 1, "output_tokens": 2,
          "usage_complete": true,
        },
      ],
      "recovered_attempts",
    ),
    (
      "sse-disconnect",
      [{
        "attempt_id": "a1", "retry_index": 0, "http_status": 200,
        "started_ms": 0, "first_byte_ms": 5,
        "stream_disconnected": true, "provider_error": false, "recovered": false,
        "input_tokens": 4, "cached_input_tokens": 0, "output_tokens": 0,
        "usage_complete": false, "error_class": "stream_disconnect",
      }],
      "transport_errors",
    ),
    (
      "malformed-partial",
      [{
        "attempt_id": "a1", "retry_index": 0, "http_status": 200,
        "started_ms": 0, "first_byte_ms": 5,
        "stream_disconnected": false, "provider_error": false, "recovered": false,
        "input_tokens": 4, "cached_input_tokens": 0, "output_tokens": 0,
        "usage_complete": false, "error_class": "malformed_sse",
      }],
      "missing_usage",
    ),
  ]
  let results : Array[FaultResult] = []
  for fault in faults {
    let (fault_id, payload, expected_key) = fault
    let output = @shell.Cmd(
      binary,
      ["attempts"],
      stdin=@shell.Stdin::Text(ToJson::to_json(payload).stringify()),
    ).output()
    guard output.exit_code() == 0 else { fail("attempt audit failed for " + fault_id) }
    let observed = @json.parse(output.stdout())
    let passed = match observed {
      Object(fields) => fields.get(expected_key) is Some(Number(value, ..)) &&
        value > 0
      _ => false
    }
    results.push({ fault_id, passed, observed })
  }
  let slow = @shell.Cmd(
    binary,
    ["health"],
    stdin=@shell.Stdin::Text("{\"probes\":10,\"successful_probes\":10,\"provider_errors\":0,\"transport_errors\":0,\"max_consecutive_failures\":0,\"first_byte_p95_ms\":16000,\"arm_failure_rate_basis_points\":0,\"time_windows\":3}"),
  ).output()
  let slow_observed = @json.parse(slow.stdout())
  results.push({
    fault_id: "slow-first-byte",
    passed: slow_observed is { "health_valid": false, .. },
    observed: slow_observed,
  })
  let timeout = @shell.Cmd(
    binary,
    ["classify"],
    stdin=@shell.Stdin::Text("{\"relay_status\":\"clean\",\"observability\":\"complete\",\"backend_observation\":\"compliant\",\"completed\":false,\"usage_complete\":false,\"correct_output\":false,\"inputs_preserved\":true,\"workspace_clean\":true,\"child_processes_clean\":true,\"receipt_valid\":false,\"trace_complete\":false,\"argv_cwd_valid\":false,\"approval_original_command\":true,\"timeout\":true}"),
  ).output()
  let timeout_observed = @json.parse(timeout.stdout())
  results.push({
    fault_id: "timeout-cancel-race",
    passed: timeout_observed is { "failure_category": "timeout", .. },
    observed: timeout_observed,
  })
  let partial = @shell.Cmd(
    binary,
    ["classify"],
    stdin=@shell.Stdin::Text("{\"relay_status\":\"clean\",\"observability\":\"partial\",\"backend_observation\":\"unknown\",\"completed\":false,\"usage_complete\":false,\"correct_output\":false,\"inputs_preserved\":true,\"workspace_clean\":true,\"child_processes_clean\":true,\"receipt_valid\":false,\"trace_complete\":false,\"argv_cwd_valid\":false,\"approval_original_command\":true,\"timeout\":false}"),
  ).output()
  let partial_observed = @json.parse(partial.stdout())
  results.push({
    fault_id: "output-limit-partial",
    passed: partial_observed is { "failure_category": "evidence_partial", .. },
    observed: partial_observed,
  })
  let malformed_probe = @shell.Cmd(
    "moon",
    ["run", "scripts/m5_probe.mbtx"],
    env={
      "M5_PROBE_HEALTH_OUTPUT": "_build/m5-results/fault-probe-health.json",
      "M5_RELAY_HEALTH_OUTPUT": "_build/m5-results/fault-relay-health.json",
    },
    stdin=@shell.Stdin::Text("[{\"attempt_id\":\"bad\",\"retry_index\":0,\"arm\":\"other\",\"time_window\":0,\"http_status\":200,\"completed_ms\":1,\"stream_disconnected\":false,\"provider_error\":false,\"transport_error\":false,\"usage_complete\":true}]"),
  ).output()
  let malformed_observed = @json.parse(malformed_probe.stdout())
  results.push({
    fault_id: "malformed-probe-arm-window",
    passed: malformed_observed is { "health_valid": false, .. },
    observed: malformed_observed,
  })
  let unknown = @shell.Cmd(
    binary,
    ["classify"],
    stdin=@shell.Stdin::Text("{\"relay_status\":\"clean\",\"observability\":\"complete\",\"backend_observation\":\"unknown\",\"completed\":false,\"usage_complete\":false,\"correct_output\":false,\"inputs_preserved\":true,\"workspace_clean\":true,\"child_processes_clean\":true,\"receipt_valid\":false,\"trace_complete\":false,\"argv_cwd_valid\":false,\"approval_original_command\":false,\"timeout\":false}"),
  ).output()
  let unknown_observed = @json.parse(unknown.stdout())
  results.push({
    fault_id: "unknown-backend-interruption",
    passed: unknown_observed is { "failure_category": "backend_observation_unknown", .. },
    observed: unknown_observed,
  })
  let evidence_path = "_build/m5-results/fault-runner-crash.json"
  if !@fs.exists("_build/m5-results") {
    @fs.mkdir("_build/m5-results", recursive=true)
  }
  @fs.write_file(evidence_path, "{\"runner\":\"crashed\",\"evidence\":\"retained\"}")
  let report : FaultReport = {
    schema_version: 5,
    experiment: "m5-fault-injection",
    results,
    artifact_retained: @fs.exists(evidence_path),
  }
  let encoded = ToJson::to_json(report).stringify()
  @fs.write_file("_build/m5-results/faults.json", encoded)
  println(encoded)
  guard report.artifact_retained && results.all(r => r.passed) else {
    fail("fault injection regression")
  }
}
