# Copy this file to $CODEX_HOME/config.toml for the Transparent MBTX arm.
# Replace the launcher path with an absolute path on the target host.
# OPENAI_API_KEY is read from the environment; it is never stored here.

model_provider = "OpenrouterICU"
model = "gpt-5.6-terra"
review_model = "gpt-5.6-terra"
model_reasoning_effort = "xhigh"
approval_policy = "never"
sandbox_mode = "workspace-write"
experimental_use_unified_exec_tool = true

# These two fields are trusted user/system configuration and are intentionally
# not valid in project-local config.
mbtx_backend = "transparent"
mbtx_command = ["/absolute/path/to/mbtx"]

[model_providers.OpenrouterICU]
name = "OpenRouter ICU"
base_url = "https://tokenadvent.com/v1"
wire_api = "responses"
requires_openai_auth = true
request_max_retries = 0
stream_max_retries = 0

[sandbox_workspace_write]
network_access = true

[features]
goals = true

# disable_response_storage and windows_wsl_setup_acknowledged are not fields in
# the pinned rust-v0.153.4 local config schema. See config/README.md.
